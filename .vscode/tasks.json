{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlanificaIO Vite frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"options": {
				"cwd": "${workspaceFolder}\\frontend",
				"env": {
					"VITE_API_URL": "http://127.0.0.1:8001"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "PlanificaIO Backend 8001 Console",
			"type": "shell",
			"command": "Set-Location backend; python manage.py runserver 127.0.0.1:8001",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}